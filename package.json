{
  "name": "@dloizides/node-observability",
  "version": "0.0.0",
  "description": "Metrics, structured logs and W3C trace context for plain node:http services, with the same metric and label names as the .NET Metrics.Client and Logging.Client packages.",
  "keywords": ["observability", "prometheus", "metrics", "pino", "logging", "traceparent", "node"],
  "author": "dloizides",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/openmindednewby/node-observability.git" },
  "homepage": "https://github.com/openmindednewby/node-observability#readme",
  "bugs": { "url": "https://github.com/openmindednewby/node-observability/issues" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "rimraf dist && tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "security:audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.32",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
